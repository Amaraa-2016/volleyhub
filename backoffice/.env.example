# Backend base URL as seen from the Next.js server. The browser never calls it directly - every
# request goes through the /api/ui/* proxy - so this is a runtime setting, not a build-time one.
API_BASE_URL=http://187.127.116.47:30090

# Must be the URL users actually open the admin at; NextAuth builds its callbacks from it.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production
